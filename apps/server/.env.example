NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=*
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/meetfair
JWT_SECRET=change-this-to-a-random-secret-with-at-least-32-characters
# Expo Push Service (https://expo.dev/accounts -> Access Tokens). Optional in local dev.
EXPO_PUSH_ACCESS_TOKEN=
# Comma-separated OAuth client IDs accepted by Google Sign-In (web, Android, iOS).
GOOGLE_CLIENT_IDS=
# Naver Cloud Platform Maps API (https://maps.apigw.ntruss.com) - geocode/directions/static map
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=
# Naver Open API (https://openapi.naver.com) - local place search (different product from Maps)
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
# ODsay Transit API (https://lab.odsay.com) - public transit directions
ODSAY_API_KEY=
# LiveKit Cloud (https://cloud.livekit.io)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# LiveKit Egress recording output. AWS S3 can leave ENDPOINT empty; R2/MinIO should set it.
RECORDING_S3_ENDPOINT=
RECORDING_S3_REGION=auto
RECORDING_S3_BUCKET=
RECORDING_S3_ACCESS_KEY=
RECORDING_S3_SECRET_KEY=
RECORDING_S3_FORCE_PATH_STYLE=false
