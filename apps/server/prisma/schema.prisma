generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MeetingStatus {
  PLANNING
  CONFIRMED
  TRACKING
  COMPLETED
  CANCELLED
}

enum SharingStatus {
  NOT_STARTED
  SHARING
  PAUSED
  ARRIVED
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum MeetingInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum MeetingVisibility {
  PRIVATE
  PUBLIC_FRIENDS
}

enum LocationShareMode {
  DAY_OF
  BEFORE_START
  OFF
}

enum TravelMetric {
  TRANSIT
  CAR
  DISTANCE
}

enum OriginType {
  HOME
  CURRENT
  CUSTOM
}

enum JoinRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum PokeType {
  MEETING
  CASUAL
}

enum MeetingCallStatus {
  RINGING
  ACTIVE
  ENDED
}

enum MeetingCallParticipantStatus {
  RINGING
  JOINED
  DECLINED
  MISSED
  LEFT
}

model User {
  id              String               @id @default(uuid())
  accountId       String               @unique
  email           String               @unique
  passwordHash    String?
  googleSubject   String?              @unique
  nickname        String
  avatarData      Bytes?
  avatarMimeType  String?
  avatarUpdatedAt DateTime?
  profileStatus   String?
  profileBio      String?
  profileEmoji    String               @default("🌟")
  profileTheme    String               @default("PURPLE")
  profileMusicTitle String?
  profileMusicData Bytes?
  profileMusicMimeType String?
  profileMusicUpdatedAt DateTime?
  profileUpdatedAt DateTime?
  accountIdChanged Boolean             @default(false)
  homeAddress      String?
  homeLatitude     Float?
  homeLongitude    Float?
  shareExactLocationWithFriends Boolean @default(false)
  currentLatitude  Float?
  currentLongitude Float?
  currentAccuracy  Float?
  currentLocationUpdatedAt DateTime?
  casualPokesEnabled Boolean            @default(true)
  pokeQuietStartMinutes Int?
  pokeQuietEndMinutes Int?
  timezone          String              @default("Asia/Seoul")
  createdAt       DateTime             @default(now())
  hostedMeetings  Meeting[]            @relation("MeetingHost")
  participations  MeetingParticipant[]
  sentFriendRequests FriendRequest[]   @relation("FriendRequestRequester")
  receivedFriendRequests FriendRequest[] @relation("FriendRequestRecipient")
  friendshipsA    Friendship[]         @relation("FriendshipUserA")
  friendshipsB    Friendship[]         @relation("FriendshipUserB")
  meetingInvitationsSent MeetingInvitation[] @relation("MeetingInvitationSender")
  meetingInvitationsReceived MeetingInvitation[] @relation("MeetingInvitationRecipient")
  meetingJoinRequests MeetingJoinRequest[]
  deviceTokens    DeviceToken[]
  votes           Vote[]
  travelEstimates TravelEstimate[]
  sentPokes       Poke[]               @relation("PokeSender")
  receivedPokes   Poke[]               @relation("PokeTarget")
  notifications   Notification[]
  callParticipants MeetingCallParticipant[]
  profileGuestbookEntries ProfileGuestbookEntry[] @relation("ProfileGuestbookOwner")
  authoredGuestbookEntries ProfileGuestbookEntry[] @relation("ProfileGuestbookAuthor")
  profilePhotos   ProfilePhoto[]
  profilePhotoLikes ProfilePhotoLike[]
  conversationsA  Conversation[]       @relation("ConversationUserA")
  conversationsB  Conversation[]       @relation("ConversationUserB")
  directMessages  DirectMessage[]      @relation("DirectMessageSender")
  blocksInitiated   Block[]          @relation("Blocker")
  blocksReceived    Block[]          @relation("Blocked")
  reports           UserReport[]
  favoritePlaces    FavoritePlace[]
  miniHome          MiniHome?
  chatMessages      MeetingChatMessage[]
  posts             MeetingPost[]
  postComments      MeetingPostComment[]
  visitsMade        MiniHomeVisit[] @relation("VisitsMade")
  visitsReceived    MiniHomeVisit[] @relation("VisitsReceived")
  recordingAccessLogs RecordingAccessLog[]
}

model ProfilePhoto {
  id        String   @id @default(uuid())
  ownerId   String
  groupId   String?
  imageData Bytes
  mimeType  String
  caption   String?
  width     Int
  height    Int
  createdAt DateTime @default(now())
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  likes     ProfilePhotoLike[]

  @@index([ownerId, createdAt])
  @@index([ownerId, groupId, createdAt])
}

model ProfilePhotoLike {
  id        String       @id @default(uuid())
  photoId   String
  userId    String
  createdAt DateTime     @default(now())
  photo     ProfilePhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([photoId, userId])
  @@index([userId, createdAt])
}

model ProfileGuestbookEntry {
  id        String   @id @default(uuid())
  ownerId   String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  owner     User     @relation("ProfileGuestbookOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  author    User     @relation("ProfileGuestbookAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt])
  @@index([authorId])
}

model DeviceToken {
  id            String   @id @default(uuid())
  userId        String
  expoPushToken String   @unique
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Meeting {
  id               String               @id @default(uuid())
  title            String
  hostId           String
  inviteCode       String               @unique
  scheduledAt      DateTime
  status           MeetingStatus        @default(PLANNING)
  visibility       MeetingVisibility     @default(PRIVATE)
  categories       String[]
  travelMetric     TravelMetric          @default(DISTANCE)
  locationShareMode LocationShareMode    @default(BEFORE_START)
  shareMinutesBefore Int?
  voteCountdownEndsAt DateTime?
  votingClosedAt   DateTime?
  placeFinalizedAt DateTime?
  completedAt      DateTime?
  locationPurgeAt  DateTime?
  retentionWarningSentAt DateTime?
  confirmedPlaceId String?              @unique
  recommendationsGeneratedAt DateTime?
  recommendationsInputHash String?
  recommendationsVersion Int @default(0)
  createdAt        DateTime             @default(now())
  host             User                 @relation("MeetingHost", fields: [hostId], references: [id])
  confirmedPlace   PlaceCandidate?      @relation("ConfirmedPlace", fields: [confirmedPlaceId], references: [id], onDelete: SetNull)
  participants     MeetingParticipant[]
  invitations      MeetingInvitation[]
  joinRequests     MeetingJoinRequest[]
  placeCandidates  PlaceCandidate[]     @relation("MeetingCandidates")
  votes            Vote[]
  pokes            Poke[]
  calls            MeetingCall[]
  chatMessages     MeetingChatMessage[]
  posts            MeetingPost[]

  @@index([hostId])
  @@index([scheduledAt])
}

model MeetingParticipant {
  id                  String        @id @default(uuid())
  meetingId           String
  userId              String
  originAddress       String?
  originType          OriginType?
  originLatitude      Float?
  originLongitude     Float?
  locationConsent     Boolean       @default(false)
  sharingStatus       SharingStatus @default(NOT_STARTED)
  readinessVerifiedAt DateTime?
  cameraPermissionGranted Boolean @default(false)
  microphonePermissionGranted Boolean @default(false)
  arrivedAt           DateTime?
  lastLatitude        Float?
  lastLongitude       Float?
  lastAccuracy        Float?
  lastLocationAt      DateTime?
  arrivalProximityCount Int          @default(0)
  joinedAt            DateTime      @default(now())
  meeting             Meeting       @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  locationSamples     LocationSample[]

  @@unique([meetingId, userId])
  @@index([userId])
}

model LocationSample {
  id            String             @id @default(uuid())
  participantId String
  latitude      Float
  longitude     Float
  accuracy      Float
  capturedAt    DateTime
  participant   MeetingParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([participantId, capturedAt])
}

model MeetingJoinRequest {
  id          String            @id @default(uuid())
  meetingId   String
  requesterId String
  status      JoinRequestStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  respondedAt DateTime?
  meeting     Meeting           @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  requester   User              @relation(fields: [requesterId], references: [id], onDelete: Cascade)

  @@unique([meetingId, requesterId])
  @@index([meetingId, status])
  @@index([requesterId, status])
}

model Friendship {
  id        String   @id @default(uuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())
  userAAllowsPokesFromB Boolean @default(true)
  userBAllowsPokesFromA Boolean @default(true)
  userA     User     @relation("FriendshipUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User     @relation("FriendshipUserB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

model FriendRequest {
  id          String              @id @default(uuid())
  requesterId String
  recipientId String
  status      FriendRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  respondedAt DateTime?
  requester   User                @relation("FriendRequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient   User                @relation("FriendRequestRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([requesterId, recipientId])
  @@index([recipientId, status])
  @@index([requesterId, status])
}

model MeetingInvitation {
  id            String                  @id @default(uuid())
  meetingId     String
  invitedUserId String
  invitedById   String
  status        MeetingInvitationStatus @default(PENDING)
  createdAt     DateTime                @default(now())
  respondedAt   DateTime?
  meeting       Meeting                 @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  invitedUser   User                    @relation("MeetingInvitationRecipient", fields: [invitedUserId], references: [id], onDelete: Cascade)
  invitedBy     User                    @relation("MeetingInvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([meetingId, invitedUserId])
  @@index([invitedUserId, status])
  @@index([invitedById])
  @@index([meetingId])
}

model PlaceCandidate {
  id              String           @id @default(uuid())
  meetingId       String
  name            String
  address         String
  latitude        Float
  longitude       Float
  category        String
  providerPlaceId String?
  createdById     String?
  recommendationRank Int?
  meeting         Meeting          @relation("MeetingCandidates", fields: [meetingId], references: [id], onDelete: Cascade)
  confirmedFor    Meeting?         @relation("ConfirmedPlace")
  travelEstimates TravelEstimate[]
  votes           Vote[]

  @@index([meetingId])
  @@unique([meetingId, providerPlaceId])
}

model TravelEstimate {
  id               String         @id @default(uuid())
  placeCandidateId String
  userId           String
  durationMinutes  Int
  distanceMeters   Int
  placeCandidate   PlaceCandidate @relation(fields: [placeCandidateId], references: [id], onDelete: Cascade)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([placeCandidateId, userId])
  @@index([userId])
}

model Vote {
  id               String         @id @default(uuid())
  meetingId        String
  placeCandidateId String
  userId           String
  meeting          Meeting        @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  placeCandidate   PlaceCandidate @relation(fields: [placeCandidateId], references: [id], onDelete: Cascade)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@index([placeCandidateId])
}

model Poke {
  id        String   @id @default(uuid())
  meetingId String?
  senderId  String
  targetId  String
  type      PokeType
  clientRequestId String
  createdAt DateTime @default(now())
  readAt    DateTime?
  summarizedAt DateTime?
  meeting   Meeting? @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  sender    User     @relation("PokeSender", fields: [senderId], references: [id], onDelete: Cascade)
  target    User     @relation("PokeTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([meetingId, targetId, createdAt])
  @@index([senderId])
  @@unique([senderId, clientRequestId])
}

model Conversation {
  id        String   @id @default(uuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userA     User     @relation("ConversationUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User     @relation("ConversationUserB", fields: [userBId], references: [id], onDelete: Cascade)
  messages  DirectMessage[]

  @@unique([userAId, userBId])
  @@index([userBId])
}

model DirectMessage {
  id              String   @id @default(uuid())
  conversationId  String
  senderId        String
  content         String
  clientMessageId String?
  createdAt       DateTime @default(now())
  readAt          DateTime?
  deletedAt       DateTime?
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          User         @relation("DirectMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@unique([conversationId, clientMessageId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model MeetingCall {
  id                    String            @id @default(uuid())
  meetingId             String            @unique
  roomName              String            @unique
  status                MeetingCallStatus @default(RINGING)
  createdAt             DateTime          @default(now())
  forcedAt              DateTime?
  endedAt               DateTime?
  recordingStatus       String            @default("PENDING")
  recordingEgressId     String?
  recordingObjectKey    String?
  recordingStartedAt    DateTime?
  recordingEndedAt      DateTime?
  recordingExpiresAt    DateTime?
  recordingDeletedAt    DateTime?
  recordingError        String?
  recordingDeleteAttempts Int       @default(0)
  meeting   Meeting           @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  participants MeetingCallParticipant[]
  recordingMessage MeetingChatMessage?

  @@index([meetingId, createdAt])
  @@index([forcedAt])
  @@index([recordingStatus, recordingExpiresAt])
}

model MeetingCallParticipant {
  id        String                       @id @default(uuid())
  callId    String
  userId    String
  status    MeetingCallParticipantStatus @default(RINGING)
  ringingAt DateTime                     @default(now())
  forcedAt  DateTime?
  respondedAt DateTime?
  joinedAt  DateTime?
  leftAt    DateTime?
  call      MeetingCall                  @relation(fields: [callId], references: [id], onDelete: Cascade)
  user      User                         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([callId, userId])
  @@index([userId, status])
  @@index([status, ringingAt])
}

model RecordingAccessLog {
  id        String   @id @default(uuid())
  meetingId String
  callId    String
  userId    String
  outcome   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([callId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}

model Block {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model UserReport {
  id         String   @id @default(uuid())
  reporterId String
  targetType String
  targetId   String
  reason     String
  status     String   @default("OPEN")
  createdAt  DateTime @default(now())
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([reporterId])
}

model FavoritePlace {
  id        String   @id @default(uuid())
  userId    String
  name      String
  address   String
  latitude  Float
  longitude Float
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model MiniHome {
  id                    String   @id @default(uuid())
  userId                String   @unique
  profileStatus         String?
  profileBio            String?
  profileEmoji          String   @default("🌟")
  profileTheme          String   @default("PURPLE")
  profileMusicTitle     String?
  profileMusicData      Bytes?
  profileMusicMimeType  String?
  profileMusicUpdatedAt DateTime?
  profileUpdatedAt      DateTime?
  createdAt             DateTime @default(now())
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MiniHomeVisit {
  id        String   @id @default(uuid())
  ownerId   String
  visitorId String
  visitedAt DateTime @default(now())
  owner     User     @relation("VisitsReceived", fields: [ownerId], references: [id], onDelete: Cascade)
  visitor   User     @relation("VisitsMade", fields: [visitorId], references: [id], onDelete: Cascade)

  @@unique([ownerId, visitorId, visitedAt])
  @@index([ownerId, visitedAt])
  @@index([visitorId, visitedAt])
}

model MeetingChatMessage {
  id              String    @id @default(uuid())
  meetingId       String
  senderId        String
  content         String
  messageType     String    @default("TEXT")
  callId          String?   @unique
  clientMessageId String?
  createdAt       DateTime  @default(now())
  deletedAt       DateTime?
  meeting         Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  sender          User      @relation(fields: [senderId], references: [id], onDelete: Cascade)
  call            MeetingCall? @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@unique([meetingId, clientMessageId])
  @@index([meetingId, createdAt])
  @@index([senderId])
}

model MeetingPost {
  id        String    @id @default(uuid())
  meetingId String
  authorId  String
  title     String
  content   String
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  meeting   Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments  MeetingPostComment[]

  @@index([meetingId, createdAt])
  @@index([authorId])
}

model MeetingPostComment {
  id        String      @id @default(uuid())
  postId    String
  authorId  String
  content   String
  createdAt DateTime    @default(now())
  deletedAt DateTime?
  post      MeetingPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User        @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([authorId])
}
