{
  "expo": {
    "name": "Meet World",
    "slug": "meetfair",
    "scheme": "meetfair",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Meet World"
    },
    "plugins": [
      ["expo-camera", {
        "cameraPermission": "모임 영상 통화와 지각 확인을 위해 카메라 접근을 허용해 주세요.",
        "microphonePermission": false,
        "recordAudioAndroid": false
      }],
      "expo-location",
      ["expo-image-picker", {
        "photosPermission": "프로필 사진을 선택하려면 사진 접근을 허용해 주세요.",
        "cameraPermission": false
      }],
      "@livekit/react-native-expo-plugin",
      "./plugins/with-video-only-webrtc"
    ],
    "ios": {
      "bundleIdentifier": "com.meetfair.app",
      "infoPlist": {
        "UIBackgroundModes": ["location"]
      }
    },
    "android": {
      "package": "com.meetfair.app",
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION", "ACCESS_BACKGROUND_LOCATION", "FOREGROUND_SERVICE", "FOREGROUND_SERVICE_LOCATION"],
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    }
  }
}
