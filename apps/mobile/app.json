{
  "expo": {
    "name": "MeetFair",
    "slug": "meetfair",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.meetfair.app"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "약속 장소와 이동 상태를 확인하기 위해 위치 권한이 필요합니다."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "준비 인증 사진을 촬영하기 위해 카메라 권한이 필요합니다.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "meeting-reminders"
        }
      ],
      "expo-status-bar"
    ]
  }
}
