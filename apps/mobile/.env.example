EXPO_PUBLIC_API_URL=https://meetfair-l5ak.onrender.com/api
EXPO_PUBLIC_SOCKET_URL=https://meetfair-l5ak.onrender.com
EXPO_PUBLIC_NAVER_MAP_NCP_KEY_ID=
EXPO_PUBLIC_KAKAO_MAP_JS_KEY=
# 배포(Vercel/EAS)에서도 지도가 보이려면: Vercel 대시보드 > Settings > Environment Variables에
# EXPO_PUBLIC_KAKAO_MAP_JS_KEY 를 동일하게 추가하고 재배포해야 합니다.
# 또한 Kakao Developers(https://developers.kakao.com) > 내 애플리케이션 > 앱 설정 > 플랫폼 > Web에
# 배포 도메인(예: https://your-app.vercel.app, https://localhost)과 https://localhost 를 모두 등록해야 합니다.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# 로컬 개발: http://192.168.0.10:4000/api 및 http://192.168.0.10:4000
